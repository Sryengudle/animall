# Local dev: postgres running on macOS Homebrew, current user, no password.
DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/pashubazaar_dev

# Min 32-char random string for HS256. Rotate before going to prod.
JWT_SECRET=change-me-this-is-only-for-local-dev-12345678
JWT_ALG=HS256
JWT_TTL_DAYS=30

# Allowed CORS origins (comma-separated).
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:4173

# "demo" returns the OTP in the response body for local testing.
# Switch to "msg91" once SMS credentials are wired.
SMS_PROVIDER=demo

# Server port. Node backend uses 5000; we use the same so the frontend's
# default doesn't change. Stop the Node backend before starting this one.
PORT=5001  # macOS AirPlay receiver squats on 5000; use 5001 locally or disable AirPlay in System Settings → General → AirDrop & Handoff
