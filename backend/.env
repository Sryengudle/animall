# Local dev config for the Node backend.
# Mongo runs via Homebrew launchd service; default URI.
MONGO_URI=mongodb+srv://hitendrapatil30_db_user:Rf2mNf6Pcj3jE7o3@cluster0.tajgz6s.mongodb.net/?appName=Cluster0

# Min 32-char random string for HS256. Rotate before going to prod.
JWT_SECRET=dev-only-secret-rotate-before-prod-abcdef1234567890abcdef1234567890

# Frontend dev origin — vite usually runs on 5173 but auto-bumps to 5174 if
# another app holds 5173. Allow both via comma-separated list (server.js takes
# the first; widen if you need more).
CLIENT_URL=http://localhost:5174

# macOS AirPlay receiver squats on 5000. Keep AirPlay on, run Node on 5002.
PORT=5002

