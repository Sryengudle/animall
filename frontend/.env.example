# Frontend env — copy to `.env` and fill in.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Google Maps JavaScript API key (Places + Geocoding).
# Without this, LocationSheet still works via GPS coords + India Post pincode
# lookup. With it, you also get place-name autocomplete + reverse geocoding
# from GPS coordinates → full address.
# Get one at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
